{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "required": ["blocks"],
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["block_uid", "model_version_id", "family_id", "block_type", "index", "qualified_name", "graph_ref", "trace_ref", "dedup_ref", "pointer"]
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["dedup_uid", "signature", "operation_ids"]
    }
  ]
}
