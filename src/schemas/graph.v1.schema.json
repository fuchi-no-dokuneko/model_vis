{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "tracer", "node_count", "edge_count", "nodes", "edges", "tensors", "modules", "module_calls", "layer_groups", "trace_modes"],
  "properties": {
    "schema_version": {"const": "2.2.0"},
    "tracer": {"const": "torch-dispatch-lineage"},
    "node_count": {"type": "integer", "minimum": 1},
    "edge_count": {"type": "integer", "minimum": 0},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "name", "module_id", "source_ref", "input_ports", "output_ports", "call_arguments", "attributes"],
        "properties": {
          "input_ports": {"type": "array", "items": {"$ref": "#/$defs/port"}},
          "output_ports": {"type": "array", "items": {"$ref": "#/$defs/port"}}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["edge_id", "source", "source_port", "target", "target_port", "tensor_id", "shape", "confidence", "evidence"],
        "properties": {
          "confidence": {"enum": ["exact", "lineage", "inferred", "ambiguous", "unresolved"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "tensors": {
      "type": "array",
      "items": {"$ref": "#/$defs/tensor"}
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["module_id", "qualified_name", "class_name", "parent_module_id", "child_module_ids", "source_ref", "constructor", "parameters", "buffers", "structural_signature", "observed_topology_signature", "layer_group_id", "call_ids"],
        "properties": {
          "constructor": {"$ref": "#/$defs/constructor"}
        }
      }
    },
    "module_calls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["call_id", "call_index", "module_id", "qualified_name", "parent_call_id", "source_ref", "input_ports", "output_ports", "call_arguments", "operation_ids", "trace_confidence"],
        "properties": {
          "input_ports": {"type": "array", "items": {"$ref": "#/$defs/port"}},
          "output_ports": {"type": "array", "items": {"$ref": "#/$defs/port"}}
        }
      }
    },
    "layer_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["layer_group_id", "module_id", "qualified_name", "display_name", "structural_signature", "runtime_signature", "color_index"]
      }
    }
  },
  "$defs": {
    "port": {
      "type": "object",
      "required": ["port_id", "direction", "index", "name", "tensor_id", "shape", "dtype", "device", "container_path", "alias_kind", "is_view", "is_copy", "is_inplace", "mutation_version", "mutation_version_before", "mutation_version_after", "required", "optional", "argument_kind", "supplied_by", "position", "keyword_name"],
      "properties": {
        "direction": {"enum": ["input", "output"]},
        "index": {"type": "integer", "minimum": 0},
        "name": {"type": "string"},
        "shape": {"type": "array", "items": {"type": "integer"}},
        "dtype": {"type": "string"},
        "device": {"type": "string"},
        "required": {"type": "boolean"},
        "optional": {"type": "boolean"},
        "is_view": {"type": "boolean"},
        "is_copy": {"type": "boolean"},
        "is_inplace": {"type": "boolean"},
        "mutation_version": {"type": ["integer", "null"]},
        "mutation_version_before": {"type": ["integer", "null"]},
        "mutation_version_after": {"type": ["integer", "null"]},
        "position": {"type": ["integer", "null"]},
        "keyword_name": {"type": ["string", "null"]}
      }
    },
    "tensor": {
      "type": "object",
      "required": ["tensor_id", "shape", "dtype", "device", "requires_grad", "stride", "storage_offset", "is_contiguous", "mutation_version", "storage_id", "base_tensor_id", "alias_kind", "is_view", "is_copy", "is_inplace", "mutation_history"],
      "properties": {
        "mutation_version": {"type": ["integer", "null"]},
        "storage_id": {"type": ["string", "null"]},
        "base_tensor_id": {"type": ["string", "null"]},
        "mutation_history": {"type": "array"}
      }
    },
    "constructor": {
      "type": "object",
      "required": ["class_name", "source_ref", "signature", "positional_arguments", "keyword_arguments", "effective_arguments", "capture_confidence", "module_id", "qualified_name"],
      "properties": {
        "capture_confidence": {"const": "actual_call"},
        "signature": {"type": "array"},
        "positional_arguments": {"type": "array"},
        "keyword_arguments": {"type": "object"},
        "effective_arguments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "kind", "supplied_by", "origin", "value"],
            "properties": {
              "supplied_by": {"enum": ["positional", "keyword", "default", "unknown"]},
              "origin": {"enum": ["runtime", "default", "config"]}
            }
          }
        }
      }
    }
  }
}
