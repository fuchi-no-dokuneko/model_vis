{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["execution_mode", "status", "device", "trace_event_count", "top_level_outputs", "operations", "line_traces"],
  "properties": {
    "status": {"const": "passed"},
    "device": {"const": "cpu"},
    "trace_event_count": {"type": "integer", "minimum": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op_id", "model_version_id", "call_index", "kind", "qualified_name", "target", "source_ref", "inputs", "outputs", "trace_confidence"]
      }
    },
    "line_traces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["line_trace_id", "source_uid", "file", "line", "executed", "op_ids", "input_shapes", "output_shapes", "variables", "control_context", "confidence"]
      }
    }
  }
}
