{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "catalog_declaration_count", "catalog_model_count", "normalized_version_count", "unique_structure_count", "deduplicated_execution_count", "selected_version_count", "executions", "failures", "passed_version_count", "no_weight_download_guard", "environment"],
  "properties": {
    "status": {"enum": ["passed", "passed_with_warnings", "failed"]},
    "no_weight_download_guard": {"const": "passed"},
    "catalog_declaration_count": {"type": "integer", "minimum": 1},
    "failures": {"type": "array"}
  }
}
