        "qualified_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "semantic_name": {
          "type": "string"
        },
        "source_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_name": {
          "type": "string"
        },
        "source_ref": {
          "type": "object"
        },
        "stage_id": {
          "type": "string"
        },
        "tags": {
          "items": {
            "$ref": "#/$defs/tag"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "what": {
          "minLength": 1,
          "type": "string"
        }
