    },
    "coverage": {
      "additionalProperties": false,
      "properties": {
        "class_tag_fraction": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "module_stage_fraction": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "operation_accounted_fraction": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "operation_stage_fraction": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "parameter_accounted_fraction": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "parameter_stage_fraction": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "verified_module_fraction": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "module_stage_fraction",
        "class_tag_fraction",
        "parameter_stage_fraction",
        "operation_stage_fraction",
        "parameter_accounted_fraction",
        "operation_accounted_fraction",
        "verified_module_fraction"
      ],
      "type": "object"
    },
    "distribution": {
      "additionalProperties": false,
      "properties": {
        "percentage": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "stage_id": {
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "stage_id",
        "value",
        "percentage"
      ],
      "type": "object"
