        "input_tensor_ids",
        "output_tensor_ids",
        "input_shapes",
        "output_shapes",
        "order",
        "importance",
        "confidence",
        "provenance",
        "module_count",
        "repeated_block_count",
        "observed_block_count",
        "template_instance_count",
        "expanded_instances_observed",
        "parameter_count",
        "operation_count"
      ],
      "type": "object"
